{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "create-react-app",
  "buildCommand": "CI=false react-scripts build",
  "outputDirectory": "build",
  "installCommand": "npm install",
  "github": { "silent": true },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
